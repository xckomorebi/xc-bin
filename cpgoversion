#!/bin/bash

set -e

if ! git rev-parse --git-dir > /dev/null 2>&1; then
    echo "error: not a git repository" >&2
    exit 1
fi

if [ ! -f go.mod ]; then
    echo "error: not a Go module (no go.mod found)" >&2
    exit 1
fi

REMOTE_URL=$(git remote get-url origin 2>/dev/null) || {
    echo "error: no remote 'origin' found" >&2
    exit 1
}

# normalize git@github.com:user/repo.git and https://github.com/user/repo.git
MODULE=$(echo "${REMOTE_URL}" | sed 's|git@\([^:]*\):\(.*\)\.git|\1/\2|; s|https://||; s|\.git$||')

COMMIT=$(git rev-parse --short HEAD)

echo "module:  ${MODULE}"
echo "commit:  ${COMMIT}"

VERSION=$(go list -m -json "${MODULE}@${COMMIT}" | jq -r '.Version')

echo "copying: ${VERSION}"
echo -n "${VERSION}" | pbcopy
