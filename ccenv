        enable)
            if (( CURRENT == 3 )); then
                local -a profiles
                local profiles_file="$HOME/.claude/profiles.toml"
                if [[ -f "$profiles_file" ]]; then
                    profiles=(${(f)"$(python3 -c "
import tomllib
with open('$profiles_file', 'rb') as f:
    for k in tomllib.load(f):
        print(k)
" 2>/dev/null)"})
                fi
                _describe 'profile' profiles
            fi
            ;;
    esac
}

_ccenv "$@"
'''


def cmd_completion(_args):
    print(COMPLETION_SCRIPT)


def main():
    parser = argparse.ArgumentParser(prog="ccenv", description="Manage Claude Code env profiles")
    sub = parser.add_subparsers(dest="command", required=True)

    p_enable = sub.add_parser("enable", help="Activate a profile")
    p_enable.add_argument("profile", help="Profile name")
    p_enable.set_defaults(func=cmd_enable)

    p_disable = sub.add_parser("disable", help="Deactivate the current profile")
    p_disable.set_defaults(func=cmd_disable)

    p_status = sub.add_parser("status", help="Show the active profile")
    p_status.set_defaults(func=cmd_status)

    p_list = sub.add_parser("list", help="List all profiles")
    p_list.set_defaults(func=cmd_list)

    p_edit = sub.add_parser("edit", help="Edit profiles.toml")
    p_edit.set_defaults(func=cmd_edit)

    p_completion = sub.add_parser("completion", help="Output zsh completion script")
    p_completion.set_defaults(func=cmd_completion)

    args = parser.parse_args()
    args.func(args)  # pyright: ignore[reportArgumentType]


if __name__ == "__main__":
    main()
